@startuml
  title Diagramma Attivita - Controllo dispositivo (Utente o Amministratore)

  start
    :Selezionare dispositivo;
    :Selezionare comando (accendi/spegni/attenua/...);
    :Inviare comando al sistema;
  if (Dispositivo raggiungibile?) then (Si)
    :Eseguire comando sul dispositivo;
    :Aggiornare stato su repository;
    :Registrare evento COMANDO_ESEGUITO;
    :Mostrare conferma;
  else (No)
    :Mostrare errore dispositivo offline;
    :Registrare evento COMANDO_FALLITO;
  endif
  stop
@enduml
