@startuml
title Diagramma Classi - Dominio Casa Intelligente

class Utente {
  +id: int
  +email: String
  +password: String
  +autentica(password: String): bool
}

class Amministratore {
  +livelloAccesso: int
  +gestisciAutomazione(auto: Automazione): void
  +consultaLog(): List<Evento>
  +creaUtente(utente: Utente): Boolean
  +eliminaUtente(id: int): Boolean
}

class Stanza {
  +id: int
  +nome: String
  +piano: int
}

class Dispositivo {
  +id: int
  +nome: String
  +tipo: String
  +stato: String
  +online: bool
  +idStanza: int
  +applicaComando(comando: String): bool
  +accendi(): void
  +spegni(): void
}

class Luce {
  +intensita: int (0-100)
  +colore: String
  +attenua(valore: int): bool
  +cambiaColore(colore: String): bool
}

class Termostato {
  +temperaturaTarget: float
  +modalita: String
  +impostaTemperatura(temp: float): bool
  +cambiaModalita(modalita: String): bool
}

class Serratura {
  +modalitaSicurezza: bool
  +blocca(): void
  +sblocca(): bool
  +attivaSicurezza(): void
  +disattivaSicurezza(): void
}

class RegolaAutomazione {
  +id: int
  +nome: String
  +condizione: String
  +azione: String
  +attiva: bool
  +orarioEsecuzione: Time
}

class Evento {
  +id: int
  +dataOra: DateTime
  +tipoEvento: String
  +messaggio: String
  +idDispositivo: int
}

Utente <|-- Amministratore
Stanza "1" -- "*" Dispositivo
Dispositivo <|-- Luce
Dispositivo <|-- Termostato
Dispositivo <|-- Serratura
RegolaAutomazione ..> Dispositivo : controlla
Evento "*" --> "0..1" Dispositivo
@enduml
