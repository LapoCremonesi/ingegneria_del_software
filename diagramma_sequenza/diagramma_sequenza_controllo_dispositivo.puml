@startuml
title Sequenza OOP - Controllo dispositivo (Utente o Amministratore)

actor Utente
actor Amministratore

box "Interfaccia"
participant "WidgetDispositivi" as WidgetDispositivi
end box

box "Logica applicativa"
participant "ControlloreDispositivi" as ControlloreDispositivi
participant "ServizioDispositivi" as ServizioDispositivi
participant "Dispositivo" as Dispositivo
participant "ServizioLog" as ServizioLog
database "RepositoryDispositivi" as RepositoryDispositivi
end box

Utente -> WidgetDispositivi : invia_comando(id_dispositivo, comando)
Amministratore -> WidgetDispositivi : invia_comando(id_dispositivo, comando)
WidgetDispositivi -> ControlloreDispositivi : invia_comando(id_dispositivo, comando)
ControlloreDispositivi -> ServizioDispositivi : invia_comando(id_dispositivo, comando)
ServizioDispositivi -> RepositoryDispositivi : trova_per_id(id_dispositivo)
RepositoryDispositivi --> ServizioDispositivi : dispositivo

alt dispositivo trovato
  ServizioDispositivi -> Dispositivo : applica_comando(comando)
  Dispositivo --> ServizioDispositivi : esito

  alt esito positivo
    ServizioDispositivi -> RepositoryDispositivi : aggiorna(dispositivo)
    ServizioDispositivi -> ServizioLog : registra_evento("COMANDO_ESEGUITO", msg)
    ServizioDispositivi --> ControlloreDispositivi : dispositivo_aggiornato
    ControlloreDispositivi --> WidgetDispositivi : mostra_risultato_comando(stato)
  else esito negativo
    ServizioDispositivi -> ServizioLog : registra_evento("COMANDO_FALLITO", msg)
    ServizioDispositivi --> ControlloreDispositivi : None
    ControlloreDispositivi --> WidgetDispositivi : errore
  end
else dispositivo non trovato
  ServizioDispositivi --> ControlloreDispositivi : None
  ControlloreDispositivi --> WidgetDispositivi : errore
end
@enduml
