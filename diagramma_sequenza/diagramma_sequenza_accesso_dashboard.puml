@startuml
title Sequenza OOP - Accesso dashboard (Utente o Amministratore)

actor Utente
actor Amministratore

box "Interfaccia"
participant "LoginDialog" as LoginDialog
participant "FinestraPrincipale" as FinestraPrincipale
participant "WidgetDashboard" as WidgetDashboard
end box

box "Logica applicativa"
participant "ControlloreAutenticazione" as ControlloreAutenticazione
participant "ControlloreSistema" as ControlloreSistema
participant "ServizioUtenti" as ServizioUtenti
participant "ServizioSistema" as ServizioSistema
participant "ServizioLog" as ServizioLog
database "RepositoryUtenti" as RepositoryUtenti
end box

Utente -> LoginDialog : inserisci_credenziali(email, password)
Amministratore -> LoginDialog : inserisci_credenziali(email, password)
LoginDialog -> ControlloreAutenticazione : effettua_login(email, password)
ControlloreAutenticazione -> ServizioUtenti : autentica(email, password)
ServizioUtenti -> RepositoryUtenti : trova_per_email(email)
RepositoryUtenti --> ServizioUtenti : utente

alt credenziali valide
  ServizioUtenti --> ControlloreAutenticazione : utente_autenticato
  LoginDialog -> ControlloreAutenticazione : login_accettato
  ControlloreAutenticazione --> LoginDialog : utente

  LoginDialog -> FinestraPrincipale : crea_finestra(id_utente, utente)
  FinestraPrincipale -> WidgetDashboard : imposta_utente(id_utente)
  WidgetDashboard -> ControlloreSistema : apri_dashboard(id_utente)
  ControlloreSistema -> ServizioSistema : carica_riepilogo(id_utente)
  ServizioSistema --> ControlloreSistema : dati_dashboard
  ControlloreSistema --> WidgetDashboard : mostra_dashboard(dati_dashboard)

  ServizioSistema -> ServizioLog : registra_evento("LOGIN_EFFETTUATO", msg)
else credenziali non valide
  ServizioUtenti --> ControlloreAutenticazione : None
  ControlloreAutenticazione --> LoginDialog : mostra_errore_login()
end
@enduml
