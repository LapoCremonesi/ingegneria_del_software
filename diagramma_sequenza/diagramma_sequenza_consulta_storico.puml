@startuml
title Sequenza OOP - Consultazione storico eventi

actor Utente
actor Amministratore

box "Interfaccia"
participant "WidgetLog" as WidgetLog
end box

box "Logica applicativa"
participant "ControlloreLog" as ControlloreLog
participant "ServizioLog" as ServizioLog
database "RepositoryEventi" as RepositoryEventi
end box

Utente -> WidgetLog : cerca_eventi(filtro)
Amministratore -> WidgetLog : cerca_eventi(filtro)
WidgetLog -> ControlloreLog : elenca_eventi(filtro)
ControlloreLog -> ServizioLog : elenca_eventi(filtro)
ServizioLog -> RepositoryEventi : cerca(filtro)
RepositoryEventi --> ServizioLog : eventi
ServizioLog --> ControlloreLog : eventi
ControlloreLog --> WidgetLog : mostra_eventi(eventi)

opt esportazione
  Utente -> WidgetLog : esporta_eventi(filtro)
  Amministratore -> WidgetLog : esporta_eventi(filtro)
  WidgetLog -> ControlloreLog : esporta_eventi(filtro)
  ControlloreLog -> ServizioLog : esporta_eventi(filtro)
  ServizioLog --> ControlloreLog : file_esportato
  ControlloreLog --> WidgetLog : mostra_risultato_esportazione(file_esportato)
end
@enduml
